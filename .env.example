# ============================================================
# AI Shorts Generator — Environment Variables Template
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# ============================================================

# ─── Required: Stock Media ───────────────────────────────────
# Pexels (free): https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay (free): https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ─── Recommended: AI Enhancement ─────────────────────────────
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Optional: Music ─────────────────────────────────────────
# Pixabay Music uses the same Pixabay API key above.
# No additional key needed.
